{
  "name": "kapikol-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build-check": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "anchor:build": "anchor build",
    "anchor:test": "anchor test",
    "test:local": "anchor test --provider.cluster localnet",
    "test:devnet": "anchor test --provider.cluster devnet",
    "test:fast": "TEST_EPOCH_DURATION=120 anchor test --provider.cluster localnet",
    "deploy:localnet": "anchor deploy --provider.cluster localnet",
    "deploy:devnet": "anchor deploy --provider.cluster devnet",
    "start-validator": "solana-test-validator --reset --ledger test-ledger --bpf-program KAPikoLaunchStakingProgram11111111111111111 target/deploy/kapikol_protocol.so"
  },
